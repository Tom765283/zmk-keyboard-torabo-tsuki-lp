#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none   &none     &none                                                              &none        &none  &none      &none    &none         &none
&none  &kp Q             &kp W     &kp E   &kp R     &kp T                                                              &kp Y        &kp U  &kp I      &kp O    &kp P         &none
&none  &kp A             &kp S     &kp D   &kp F     &kp G        &none                      &none                      &kp H        &kp J  &kp K      &kp L    &kp SEMI      &none
&none  &mt LEFT_SHIFT Z  &kp X     &kp C   &kp V     &kp B        &trans                     &trans                     &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH      &none
&none  &kp LCTRL         &kp LGUI  &trans  &kp BSPC  &lt 2 ENTER  &lt 3 LANG_ZENKAKUHANKAKU  &lt 3 LANG_ZENKAKUHANKAKU  &lt 1 SPACE  &none  &none      &none    &kp LEFT_ALT  &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none   &none   &none             &none              &none                   &none   &none       &none       &none   &none                 &none
&none  &kp N1  &kp N2  &kp N3            &kp N4             &kp N5                  &kp N6  &kp N7      &kp N8      &kp N9  &kp N0                &none
&none  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &none   &none   &trans  &kp LS(N8)  &kp LS(N9)  &trans  &kp NON_US_BACKSLASH  &none
&none  &trans  &trans  &trans            &trans             &trans  &trans  &trans  &trans  &trans      &trans      &trans  &kp LS(BACKSLASH)     &none
&none  &trans  &trans  &trans            &trans             &trans  &trans  &trans  &trans  &none       &none       &none   &trans                &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none            &none          &none       &none       &none                              &none      &none       &none         &none          &none              &none
&none  &kp LS(N1)       &kp AT_SIGN    &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                         &kp CARET  &kp LS(N6)  &kp ASTERISK  &kp MINUS      &kp LS(BACKSLASH)  &none
&none  &kp LS(AT_SIGN)  &kp RS(CARET)  &kp LS(N2)  &kp LS(N7)  &kp C_VOLUME_UP  &none    &none    &mkp MCLK  &mkp LCLK   &mkp RCLK     &kp LS(MINUS)  &kp LS(SEMI)       &none
&none  &kp F1           &kp F2         &kp F3      &kp F4      &kp F5           &kp F11  &kp F12  &kp F6     &kp F7      &kp F8        &kp F9         &kp F10            &none
&none  &trans           &trans         &trans      &trans      &trans           &trans   &trans   &trans     &none       &none         &none          &trans             &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none   &none            &none      &none        &none                   &none   &none       &none        &none          &none   &none
&none  &trans  &kp LC(LS(TAB))  &kp PSCRN  &kp LC(TAB)  &trans                  &trans  &kp HOME    &kp UP       &kp END        &trans  &none
&none  &trans  &trans           &trans     &trans       &trans  &none   &none   &trans  &kp LEFT    &kp DOWN     &kp RIGHT      &trans  &none
&none  &trans  &kp LEFT_SHIFT   &trans     &trans       &trans  &trans  &trans  &trans  &kp DELETE  &kp PAGE_UP  &kp PAGE_DOWN  &trans  &none
&none  &trans  &trans           &trans     &trans       &trans  &trans  &trans  &trans  &trans      &trans       &trans         &trans  &none
            >;
        };
    };
};
